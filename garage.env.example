# Copy to garage.env and adjust. garage.env is git-ignored.
TV=192.168.1.50:26101                      # your TV's IP and developer port
CERT_DIR=$HOME/SamsungCertificate/garage   # Samsung certificate profile folder (author.p12, distributor.p12)
KEYCHAIN_SERVICE=garage-signing            # macOS Keychain entry for the certificate passwords
# Optional: fixed weather location (otherwise the TV is located by its IP)
# GARAGE_PLACE='{city: "Tirana", lat: 41.33, lon: 19.82}'
# Optional: Garage Player without Vetro (hides "Add playlist from phone", loads playlists directly)
# GARAGE_STANDALONE=1
